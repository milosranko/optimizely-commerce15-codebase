@using Commerce.Demo.Optimizely.ContentTypes.Cms.Pages.Interfaces
@using Commerce.Demo.Web.Models.Pages
@using EPiServer.Framework.Web.Mvc.Html
@model IPageViewModel<ILayoutPageBase>

<!DOCTYPE html>
<html lang="@Model.CurrentPage.Language.Name" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>
        @Model.Layout.PageTitle
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @if (IsSectionDefined("MetaData"))
    {
        @await RenderSectionAsync("MetaData", false)
    }

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" crossorigin="anonymous"></script>    
    <link rel="shortcut icon" href="/Static/Img/favicon.ico">
    <link rel="apple-touch-icon" href="/Static/Img/apple-touch-icon.png">
    <link rel="icon" href="/Static/Img/touch-icon.png">

    @Html.CanonicalLink()
    @Html.AlternateLinks()
    @Html.RequiredClientResources("Header")

    @if (IsSectionDefined("HeadSnippets"))
    {
        @await RenderSectionAsync("HeadSnippets", false)
    }
</head>
<body>
    @await Html.RenderEPiServerQuickNavigatorAsync()

    @if (IsSectionDefined("BodySnippets"))
    {
        @await RenderSectionAsync("BodySnippets", false)
    }
    
    @if (IsSectionDefined("Header"))
    {
        @await RenderSectionAsync("Header", false)
    }

    <main id="main">
        @RenderBody()
    </main>

    @if (IsSectionDefined("Footer"))
    {
        @await RenderSectionAsync("Footer", false)
    }
    
    @{
        await Html.RenderPartialAsync("_CookiesConsentDialog", Model.Layout.CookiesConsent);
    }
    
    @if (IsSectionDefined("FooterSnippets"))
    {
        @await RenderSectionAsync("FooterSnippets", false)
    }
    
    @await RenderSectionAsync("AdditionalScripts", required: false)
</body>
</html>
