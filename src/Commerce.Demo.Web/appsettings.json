{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "EPiServer": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/log.json",
          "rollingInterval": "Hour",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Optimizely": {
    "ContentGraph": {
      "GatewayAddress": "https://cg.optimizely.com",
      "AppKey": "",
      "Secret": "",
      "SingleKey": ""
    }
  },
  "EPiServer": {
    "OptimizelyIdentity": {
      "InstanceId": "",
      "ClientId": "",
      "ClientSecret": ""
    },
    "OpalChat": {
      "InstanceId": ""
    },
    "CmsUI": {
      "Upload": {
        "FileSizeLimit": 62914560
      }
    },
    "Cms": {
      "DataAccess": {
        "CreateDatabaseSchema": "true"
      },
      "Smtp": {
        "DeliveryMethod": "Network",
        "Network": {
          "Host": "smtp.sendgrid.net",
          "Port": "587",
          "UserName": "apikey",
          "Password": ""
        }
      },
      "Notification": {
        "NotificationEmailDisplayName": "DisplayName",
        "NotificationEmailAddress": "noreply@domain.com"
      },
      "MappedRoles": {
        "Items": {
          "CmsEditors": {
            "MappedRoles": [
              "WebEditors",
              "WebAdmins"
            ]
          },
          "CmsAdmins": {
            "MappedRoles": [
              "WebAdmins"
            ]
          },
          "CommerceAdmins": {
            "MappedRoles": [
              "WebAdmins"
            ]
          },
          "OrderManagers": {
            "MappedRoles": [
              "WebAdmins"
            ]
          },
          "BusinessFoundations": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "CatalogIndexing": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "CatalogManagers": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "Countries": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "CustomerServiceRepresentatives": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "Dashboard": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "Dictionaries": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "MarketingManagers": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "Markets": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "PaymentMethods": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "ReportManagers": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "ShippingMethods": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "Taxes": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "Warehouses": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "CustomerManagers": {
            "MappedRoles": [ "Commerce Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          },
          "SearchAdmins": {
            "MappedRoles": [ "Content Admins", "Administrators" ],
            "ShouldMatchAll": "false"
          }
        }
      }
    }
  },
  "Commerce": {
    "SearchOptions": {
      "DefaultSearchProvider": "FindSearchProvider",
      "MaxHitsForSearchResults": 1000,
      "SearchProviders": [
        {
          "Name": "FindSearchProvider",
          "Type": "EPiServer.Commerce.FindSearchProvider.FindSearchProvider, EPiServer.Commerce.FindSearchProvider",
          "Parameters": {
            "queryBuilderType": "EPiServer.Commerce.FindSearchProvider.FindSearchQueryBuilder, EPiServer.Commerce.FindSearchProvider",
            "simulateFaceting": "true"
          }
        }
      ],
      "Indexers": [
        {
          "Name": "catalog",
          "Type": "EPiServer.Commerce.FindSearchProvider.FindSearchIndexBuilder, EPiServer.Commerce.FindSearchProvider"
        }
      ]
    },
    "CatalogOptions": {
      "SalePriceTypes": [
        {
          "Key": "AlternatePricing",
          "Value": "3",
          "Description": "Claim Based Price"
        }
      ],
      "SkipCatalogContentModelCheck": true
    },
    "DashboardOptions": {
      "EnableTrackingSession": true
    }
  },
  "Hangfire": {
    "WorkerCount": 2,
    "Queues": [
      "orders",
      "default"
    ],
    "ServerTimeout": "00:05:00",
    "RetryAttempts": 5,
    "DashboardPath": "/episerver/hangfire",
    "FailureNotification": {
      "Enabled": true,
      "Recipients": [],
      "FromAddress": "noreply@domain.com",
      "FromDisplayName": "Background Jobs"
    }
  },
  "CookieConsentAudit": {
    "RetentionDays": 1095,
    "DefaultPageSize": 50,
    "EnableAuditLogging": true
  }
}
