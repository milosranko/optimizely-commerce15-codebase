<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- CMS 13 / Commerce 15 packages are served from the new Optimizely feed. -->
    <add key="optimizely" value="https://nuget.optimizely.com/v3/index.json" />
    <!-- Local feed: CmsContentScaffolding.Optimizely 2.0.0 (CMS 13 build) is only published here. -->
    <add key="My Offline Packages" value="D:\Packages" />
  </packageSources>
</configuration>
